---
// A clickable/hoverable diagram. Put an <img> or inline <svg> in the
// default slot, and describe hotspots as percentages of the diagram's
// bounding box so they stay aligned at any width.
//
// Usage inside a .mdx note:
//   <Schematic hotspots={[
//     { x: 20, y: 30, label: 'Entity', note: 'Just an id, no data or logic.' },
//     { x: 70, y: 60, label: 'System', href: '/glossary/ecs' },
//   ]}>
//     <img src="/diagrams/ecs.svg" alt="ECS overview" />
//   </Schematic>

interface Hotspot {
	x: number; // 0-100, % from the left
	y: number; // 0-100, % from the top
	label: string;
	note?: string;
	href?: string;
}

interface Props {
	hotspots?: Hotspot[];
	caption?: string;
}

const { hotspots = [], caption } = Astro.props;
---

<figure class="schematic">
	<div class="schematic-canvas">
		<slot />
		{hotspots.map((h) => {
			const Tag = h.href ? 'a' : 'button';
			return (
				<Tag
					class="hotspot"
					style={`left: ${h.x}%; top: ${h.y}%;`}
					href={h.href}
					type={h.href ? undefined : 'button'}
					aria-label={h.label}
				>
					<span class="dot"></span>
					<span class="hotspot-tooltip">
						<strong>{h.label}</strong>
						{h.note && <span>{h.note}</span>}
					</span>
				</Tag>
			);
		})}
	</div>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.schematic {
		margin: 1.5em 0;
	}
	.schematic-canvas {
		position: relative;
		display: inline-block;
		width: 100%;
		line-height: 0;
	}
	.schematic-canvas :global(img),
	.schematic-canvas :global(svg) {
		width: 100%;
		display: block;
		border-radius: 8px;
	}
	.hotspot {
		position: absolute;
		transform: translate(-50%, -50%);
		background: none;
		border: none;
		padding: 0;
		cursor: pointer;
		line-height: 0;
	}
	.dot {
		display: block;
		width: 14px;
		height: 14px;
		border-radius: 50%;
		background: var(--accent);
		border: 2px solid white;
		box-shadow: 0 0 0 2px var(--accent);
	}
	.hotspot-tooltip {
		display: none;
		position: absolute;
		left: 50%;
		bottom: 130%;
		transform: translateX(-50%);
		width: max-content;
		max-width: 240px;
		background: rgb(var(--black));
		color: white;
		font-size: 0.8rem;
		line-height: 1.4;
		padding: 0.5em 0.75em;
		border-radius: 6px;
		text-align: left;
	}
	.hotspot-tooltip strong {
		display: block;
		color: white;
	}
	.hotspot:hover .hotspot-tooltip,
	.hotspot:focus .hotspot-tooltip {
		display: block;
	}
	figcaption {
		margin-top: 0.5em;
		font-size: 0.85rem;
		color: rgb(var(--gray));
		text-align: center;
	}
</style>
