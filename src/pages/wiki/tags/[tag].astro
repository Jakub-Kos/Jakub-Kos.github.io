---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { typeMeta } from '../../../utils/wiki';

export async function getStaticPaths() {
	const entries = await getCollection('wiki');
	const tags = new Set(entries.flatMap((e) => e.data.tags));
	return [...tags].map((tag) => ({
		params: { tag },
		props: { entries: entries.filter((e) => e.data.tags.includes(tag)) },
	}));
}

const { tag } = Astro.params;
const { entries } = Astro.props;
entries.sort((a, b) => b.data.created.valueOf() - a.data.created.valueOf());
---
<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Tag: ${tag}`} description={`Wiki entries tagged ${tag}`} />
	</head>
	<body>
		<Header />
		<main style="max-width: 800px; margin: 0 auto; padding: 2rem 1rem;">
			<p><a href="/wiki/tags">&larr; all tags</a></p>
			<h1>#{tag}</h1>
			<ul style="list-style: none; padding: 0;">
				{entries.map((entry) => {
					const meta = typeMeta(entry.data.type);
					return (
						<li style="margin-bottom: 1rem; padding-bottom: 1rem; border-bottom: 1px solid #e2e8f0;">
							<span
								style={`display:inline-block; background:${meta.color}; color:white; font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.03em; padding:0.1rem 0.5rem; border-radius:999px; margin-right:0.5rem;`}
							>
								{meta.label}
							</span>
							<a href={`/wiki/${entry.id}`} style="font-size: 1.15rem; font-weight: bold; text-decoration: none; color: #0f172a;">
								{entry.data.title}
							</a>
						</li>
					);
				})}
			</ul>
		</main>
		<Footer />
	</body>
</html>
