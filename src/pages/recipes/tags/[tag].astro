---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
	const entries = await getCollection('recipes', ({ data }) => !data.draft);
	const tags = new Set(entries.flatMap((e) => e.data.tags));
	return [...tags].map((tag) => ({
		params: { tag },
		props: { entries: entries.filter((e) => e.data.tags.includes(tag)) },
	}));
}

const { tag } = Astro.params;
const { entries } = Astro.props;
entries.sort((a, b) => b.data.created.valueOf() - a.data.created.valueOf());
---
<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Tag: ${tag}`} description={`Recipes tagged ${tag}`} />
		<style>
			body.recipe-body {
				background: var(--recipe-bg);
			}
		</style>
	</head>
	<body class="recipe-theme recipe-body">
		<Header />
		<main style="max-width: 800px; margin: 0 auto; padding: 2rem 1rem;">
			<p><a href="/recipes/tags" style="color: var(--recipe-primary);">&larr; all tags</a></p>
			<h1 style="font-family: var(--recipe-title-font); font-weight: 400;">#{tag}</h1>
			<ul style="list-style: none; padding: 0;">
				{entries.map((entry) => (
					<li style="margin-bottom: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--recipe-cream);">
						<a href={`/recipes/${entry.id}`} style="font-family: var(--recipe-title-font); font-size: 1.15rem; text-decoration: none; color: var(--recipe-ink);">
							{entry.data.title}
						</a>
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>
