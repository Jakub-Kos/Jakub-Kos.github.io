---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Welcome to my page</h1>
                <p>
                    Hi, I'm building this space to house everything I do. It is part portfolio,
                    part blog, and part digital brain.
                </p>
			<ul>
                <li><strong>Wiki:</strong> Where I keep my class notes and project documentation.</li>
                <li><strong>Knowledge Map:</strong> An interactive map of how my notes connect.</li>
                <li><strong>Blog:</strong> Where I write about what I'm learning.</li>
            </ul>
            <p>Feel free to explore!</p>
		</main>
		<Footer />
	</body>
</html>
